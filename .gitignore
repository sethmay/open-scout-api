# Agent workspace (reviews, lessons audit trail, scratch) — never committed
.workbench/

# Feature worktrees (WORKFLOW.md lifecycle)
.claude/worktrees/

# OS noise
Thumbs.db
.DS_Store

# Proprietary source maps (Scouting America) — facts extracted, images NOT redistributed
maps/
*.jpg
*.jpeg

# WorldClim source rasters (~8 GB, tools/july_temp.py input; see README "Contributing")
# Not redistributed — fetched on demand; the derived tools/july_temp.json cache IS committed.
tools/worldclim/

# Python (future pipeline)
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Node (cookbook/ts workspace) + build output (tools/build.py -> dist/, deployed to Pages via CI)
# cookbook/ts/package-lock.json IS committed, so the cookbook gate installs deterministically.
node_modules/
dist/

# .NET build output (cookbook/csharp)
bin/
obj/
