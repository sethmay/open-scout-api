{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sethmay.github.io/open-scout-api/schema/v1/published-current.schema.json",
  "title": "Open Scout API — published 'current' collection",
  "description": "Root schema for the denormalized, current-only consumer projections emitted by tools/build.py to v1/current/*.json (councils, territories, merit-badges, camps, ranks, awards, oa-lodges, requirement-sets). NOT the canonical layer — flattened, current-only (entities with an open valid_to:null version; retired/defunct excluded; requirement-sets: the in-force edition per subject), self-contained (no cross-file $ref). Fields are ADDITIVE-ONLY under v1 (a stable consumer contract): new optional fields may appear, but existing fields are not renamed or removed. Point a validator at any current/*.json file to validate it. The lighter v1/{dataset}/index.json listings have their own published contract, published-index.schema.json.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "council",
        "territory",
        "merit-badge",
        "camp",
        "rank",
        "award",
        "oa-lodge",
        "requirement-set"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "version",
    "generated_at",
    "kind",
    "count",
    "items"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "council"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/CurrentCouncil"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "territory"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/CurrentTerritory"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "merit-badge"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/CurrentMeritBadge"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "camp"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/CurrentCamp"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "rank"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/CurrentRank"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "award"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/CurrentAward"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "oa-lodge"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/CurrentOALodge"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "requirement-set"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/CurrentRequirementSet"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "CurrentCouncil": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bsa_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "hq_city": {
          "type": [
            "string",
            "null"
          ]
        },
        "hq_state": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "website": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "territory": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^territory:[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "territory_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "name",
        "bsa_number",
        "hq_city",
        "hq_state",
        "website",
        "territory",
        "territory_number",
        "verified_at",
        "method",
        "confidence"
      ],
      "additionalProperties": false
    },
    "CurrentTerritory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "division_type": {
          "enum": [
            "council_service_territory",
            "national_service_territory",
            "region",
            "area"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "number",
        "name",
        "division_type",
        "verified_at",
        "method",
        "confidence"
      ],
      "additionalProperties": false
    },
    "CurrentMeritBadge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short original-prose summary of what a Scout does to earn the badge, written for browsing. Deliberately NOT the pamphlet or requirement wording: requirement text is © Scouting America and is published only under the `text_rights` carve-out on requirement-sets, so this field is original and CC-licensed. A build gate rejects any description sharing 8 consecutive words with the badge's own requirement text."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "eagle_required": {
          "type": "boolean"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "eagle_required",
        "tags",
        "url",
        "verified_at",
        "method",
        "confidence"
      ],
      "additionalProperties": false
    },
    "CurrentCamp": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "camp_type": {
          "type": "string"
        },
        "operator": {
          "enum": [
            "council",
            "national",
            "other",
            "unknown"
          ]
        },
        "council": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^council:[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^camp:[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "geo_precision": {
          "enum": [
            "exact",
            "approximate",
            null
          ]
        },
        "elevation_ft": {
          "type": [
            "integer",
            "null"
          ]
        },
        "july_high_f": {
          "type": [
            "integer",
            "null"
          ]
        },
        "july_low_f": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reservation": {
          "type": [
            "object",
            "null"
          ],
          "description": "Set when this camp shares a location with other distinct camps: a grouping so consumers render one reservation pin per property. `id` is a STABLE OPAQUE GROUPING KEY — deliberately a bare slug, NOT a '{kind}:{slug}' entity reference, because no reservation entity exists. If a reservation dataset is ever added it will reuse these exact slugs as its entity ids, and any entity reference will arrive as a NEW additive field; this `id` will not change format or meaning. Group by it; do not parse it.",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "website": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "program_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "What this camp offers, as codes from the open `camp-features` vocabulary published at v1/vocab/camp-features.json. Sorted, unique, and flattened for filtering: the canonical per-camp document (v1/camps/{id}.json) carries the same features as objects with an optional prose `note`, which is deliberately NOT republished here — this projection is the filterable one. Codes form a shallow hierarchy via each term's `broader`, so a consumer filtering on a coarse code must expand it to its descendants (asking for `aquatics` should match a camp offering only `kayaking`). ALWAYS read alongside `features_verified_at`: an empty array on its own does NOT mean the camp offers nothing."
        },
        "features_signature": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "The subset of `features` a camp presents as a headline draw rather than table stakes — the same feature can be signature at one camp and unremarkable at another (a climbing tower is ordinary in Colorado and a real differentiator on the prairie). Intended for ranking and badge rendering in list views, not for filtering. Always a subset of `features`."
        },
        "features_source_tier": {
          "enum": [
            "guide",
            "camp_page",
            "portal",
            null
          ],
          "description": "How complete the source behind `features` was, in the same spirit as `geo_precision` for coordinates. `guide`: a camp-specific document was read (leader's/program guide, schedule, or labelled map) — averages 21 features per camp. `camp_page`: a descriptive page owned by the camp or council — averages 13. `portal`: only a registration-platform blurb existed because the camp has no descriptive page anywhere; these are deliberately thin and are the dataset's manual-review queue. `null` exactly when `features_verified_at` is null. Rank and trust completeness by this field: a `portal` feature list is a floor, not a description."
        },
        "features_verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date of the last deliberate features survey of this camp against its own sources. Four states, and the distinction matters: `null` + empty `features` = never surveyed, nothing is known; `null` + non-empty = features arrived from a bulk import and were never deliberately verified; a date + non-empty = surveyed, and this is what was found; a date + empty = surveyed and the camp's own page described no offerings. A date means a survey happened, NOT that the list is complete — camp pages are rarely exhaustive, and a camp surveyed before a vocabulary term existed cannot carry it."
        },
        "council_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "council_website": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "council_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "imported_at": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "name",
        "camp_type",
        "operator",
        "council",
        "parent",
        "reservation",
        "council_name",
        "council_website",
        "council_number",
        "state",
        "city",
        "lat",
        "lon",
        "geo_precision",
        "website",
        "url",
        "summary",
        "program_types",
        "features",
        "features_signature",
        "features_verified_at",
        "features_source_tier",
        "verified_at",
        "imported_at",
        "method",
        "confidence"
      ],
      "additionalProperties": false
    },
    "CurrentRank": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "program": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "name",
        "program",
        "order",
        "url",
        "verified_at",
        "method",
        "confidence"
      ],
      "additionalProperties": false
    },
    "CurrentAward": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string"
        },
        "audience": {
          "enum": [
            "youth",
            "adult",
            "both"
          ]
        },
        "programs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "square_knot_no": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "audience",
        "square_knot_no",
        "verified_at",
        "method",
        "confidence"
      ],
      "additionalProperties": false
    },
    "CurrentOALodge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "council": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^council:[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "hq_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "lat": {
          "type": [
            "number",
            "null"
          ]
        },
        "lon": {
          "type": [
            "number",
            "null"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "name",
        "council",
        "section",
        "verified_at",
        "method",
        "confidence"
      ],
      "additionalProperties": false
    },
    "CurrentRequirementSet": {
      "type": "object",
      "description": "The in-force requirement-set document for a subject (rank or merit badge): effective_to is null. A requirement-set is immutable and effective-dated rather than versioned, so it has no `current` flag. Requirement CONTENT lives in the per-document file v1/requirement-sets/{id}.json — this projection is the pointer plus the licensing flag.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "subject": {
          "type": "string",
          "pattern": "^[a-z]([a-z-]*[a-z])?:[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "effective_from": {
          "type": "string",
          "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
        },
        "includes_official_text": {
          "type": "boolean"
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "subject",
        "effective_from",
        "includes_official_text",
        "verified_at",
        "method",
        "confidence"
      ],
      "additionalProperties": false
    }
  }
}
