{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sethmay.github.io/open-scout-api/schema/v1/published-index.schema.json",
  "title": "Open Scout API — published dataset index (listing)",
  "description": "Root schema for the lightweight listing projections emitted by tools/build.py to v1/{dataset}/index.json (councils, territories, merit-badges, camps, ranks, awards, oa-lodges, requirement-sets). One entry per entity INCLUDING retired/defunct ones — a `current` boolean says whether the entity has an open (valid_to:null) version, which is the difference from v1/current/*.json (current-only, denormalized, richer). An index item carries just an id plus the few fields needed to list, filter, or link: enough to build a picker without fetching every entity document. NOT the canonical layer and no cross-file $ref (self-contained). Fields are ADDITIVE-ONLY under v1 (a stable consumer contract): new optional fields may appear, but existing fields are not renamed or removed. Point a validator at any v1/{dataset}/index.json file to validate it.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "kind": { "enum": ["council", "territory", "merit-badge", "camp", "rank", "award", "oa-lodge", "requirement-set"] },
    "count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/CouncilIndexItem" },
          { "$ref": "#/$defs/TerritoryIndexItem" },
          { "$ref": "#/$defs/MeritBadgeIndexItem" },
          { "$ref": "#/$defs/CampIndexItem" },
          { "$ref": "#/$defs/RankIndexItem" },
          { "$ref": "#/$defs/AwardIndexItem" },
          { "$ref": "#/$defs/OALodgeIndexItem" },
          { "$ref": "#/$defs/RequirementSetIndexItem" }
        ]
      }
    }
  },
  "required": ["version", "generated_at", "kind", "count", "items"],
  "additionalProperties": false,
  "$defs": {
    "Slug": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
    "HistoricalDate": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" },
    "CouncilIndexItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "bsa_number": { "type": ["integer", "null"], "minimum": 1 },
        "hq_state": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "territory": { "type": ["string", "null"], "pattern": "^territory:[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
        "current": { "type": "boolean" }
      },
      "required": ["id", "name", "bsa_number", "hq_state", "territory", "current"],
      "additionalProperties": false
    },
    "TerritoryIndexItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "current": { "type": "boolean" }
      },
      "required": ["id", "name", "current"],
      "additionalProperties": false
    },
    "MeritBadgeIndexItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "eagle_required": { "type": "boolean" },
        "current": { "type": "boolean" }
      },
      "required": ["id", "name", "eagle_required", "current"],
      "additionalProperties": false
    },
    "CampIndexItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "camp_type": { "type": "string" },
        "operator": { "type": "string" },
        "council": { "type": ["string", "null"], "pattern": "^council:[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
        "state": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "current": { "type": "boolean" }
      },
      "required": ["id", "name", "camp_type", "operator", "council", "state", "current"],
      "additionalProperties": false
    },
    "RankIndexItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "program": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "current": { "type": "boolean" }
      },
      "required": ["id", "name", "program", "order", "current"],
      "additionalProperties": false
    },
    "AwardIndexItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "audience": { "type": "string" },
        "current": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "audience", "current"],
      "additionalProperties": false
    },
    "OALodgeIndexItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "name": { "type": "string", "minLength": 1 },
        "council": { "type": ["string", "null"], "pattern": "^council:[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
        "section": { "type": ["string", "null"] },
        "current": { "type": "boolean" }
      },
      "required": ["id", "name", "council", "section", "current"],
      "additionalProperties": false
    },
    "RequirementSetIndexItem": {
      "type": "object",
      "description": "A requirement-set document is immutable and effective-dated rather than versioned, so it carries effective_from/effective_to instead of a `current` flag; `effective_to: null` means it is the in-force edition for its subject.",
      "properties": {
        "id": { "$ref": "#/$defs/Slug" },
        "subject": { "type": "string", "pattern": "^[a-z]([a-z-]*[a-z])?:[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
        "effective_from": { "$ref": "#/$defs/HistoricalDate" },
        "effective_to": { "anyOf": [{ "$ref": "#/$defs/HistoricalDate" }, { "type": "null" }] },
        "includes_official_text": { "type": "boolean" }
      },
      "required": ["id", "subject", "effective_from", "effective_to", "includes_official_text"],
      "additionalProperties": false
    }
  }
}
